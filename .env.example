
# ─── Base URL & Auth ──────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="votre-cle-secrete-nextauth"

# ─── Cloudflare Worker & D1 Backend ───────────────────────────────────────────
BACKEND_API_URL="https://votre-worker.workers.dev"
CLOUDFLARE_WORKER_URL="https://votre-worker.workers.dev"
FRONTEND_API_SECRET="votre_secret_api"

# ─── Convex Cloud ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL="https://greedy-mastiff-107.convex.cloud"

# ─── Paddle Billing (Sandbox & Production) ───────────────────────────────────
# Client Token (Commence par test_ en sandbox ou live_ en production)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Environnement Paddle : "sandbox" ou "production"
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# Server API Key (Dashboard Paddle > Authentification)
PADDLE_API_KEY="paddler_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Webhook Secret Key (Dashboard Paddle > Notifications d'événements)
PADDLE_WEBHOOK_SECRET_KEY="pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Paddle Price IDs (Optionnel / Configurables dans le Dashboard Paddle)
# NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY="pri_01xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY="pri_01xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_MONTHLY="pri_01xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_YEARLY="pri_01xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_MONTHLY="pri_01xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_PADDLE_PRICE_ENTERPRISE_YEARLY="pri_01xxxxxxxxxxxxxxxxxxxxxx"
# Paddle Discount IDs (2 billing periods promotion)
# NEXT_PUBLIC_PADDLE_DISCOUNT_PRO_MONTHLY="dsc_01xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_PADDLE_DISCOUNT_BUSINESS_MONTHLY="dsc_01xxxxxxxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_PADDLE_DISCOUNT_ENTERPRISE_MONTHLY="dsc_01xxxxxxxxxxxxxxxxxxxxxx"

# ─── Google Analytics 4 (GA4) ─────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID="G-3WMV9FJFFV"

